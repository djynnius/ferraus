{
  "command": "generate tone",
  "summary": "Generate a test tone or sweep",
  "category": "edit",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/generate_tone.args.json",
    "title": "ferraus generate tone arguments",
    "description": "Generate a test tone or sweep",
    "type": "object",
    "properties": {
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "freq": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Frequency (Hz, kHz, or a note such as A4) Type: frequency.",
        "default": "440Hz",
        "x-ferraus-kind": "freq"
      },
      "dur": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Duration Type: time.",
        "default": "5s",
        "x-ferraus-kind": "time"
      },
      "shape": {
        "type": "string",
        "enum": [
          "sine",
          "square",
          "saw",
          "triangle"
        ],
        "description": "Waveform Type: choice.",
        "default": "sine",
        "x-ferraus-kind": "choice"
      },
      "sweep": {
        "type": "string",
        "description": "Sweep from low to high over the duration, e.g. 20Hz..20kHz (overrides --freq) Type: text.",
        "x-ferraus-kind": "str"
      },
      "sweep_curve": {
        "type": "string",
        "enum": [
          "log",
          "linear"
        ],
        "description": "Sweep spacing: logarithmic (equal time per octave) or linear Type: choice.",
        "default": "log",
        "x-ferraus-kind": "choice"
      },
      "amplitude": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Peak level in dBFS Type: gain.",
        "default": "-3dB",
        "x-ferraus-kind": "gain"
      }
    },
    "required": [],
    "additionalProperties": false
  },
