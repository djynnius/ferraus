{
  "command": "deess",
  "summary": "Reduce sibilance",
  "category": "dynamics",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/deess.args.json",
    "title": "ferraus deess arguments",
    "description": "Reduce sibilance",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "center": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Detector centre frequency Type: frequency.",
        "default": "6.5kHz",
        "x-ferraus-kind": "freq"
      },
      "bandwidth": {
        "type": "string",
        "description": "Detector bandwidth in octaves (e.g. 1oct, 0.5oct) Type: text.",
        "default": "1oct",
        "x-ferraus-kind": "str"
      },
      "threshold": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Detector level where reduction starts Type: gain.",
        "default": "-20dB",
        "x-ferraus-kind": "gain"
      },
      "range": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Maximum reduction Type: gain.",
        "default": "6dB",
        "x-ferraus-kind": "gain"
      },
      "mode": {
        "type": "string",
        "enum": [
          "split",
          "wideband"
        ],
        "description": "split: turn down only the highs; wideband: turn down everything Type: choice.",
        "default": "split",
        "x-ferraus-kind": "choice"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/deess.result.json",
    "title": "ferraus deess result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "deess"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
