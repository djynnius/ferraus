{
  "command": "dynamics",
  "summary": "Transfer-curve dynamics: compressor, expander, and gate from one curve",
  "category": "dynamics",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/dynamics.args.json",
    "title": "ferraus dynamics arguments",
    "description": "Transfer-curve dynamics: compressor, expander, and gate from one curve",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "curve": {
        "type": "string",
        "description": "Transfer curve as input:output dB points, e.g. -100:-100,-20:-20,0:-10 Type: text.",
        "default": "-100:-100,-40:-50,0:-10",
        "x-ferraus-kind": "str"
      },
      "spline": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Smooth the curve through the points (on) or join them with straight lines (off) Type: on|off.",
        "default": "on",
        "x-ferraus-kind": "switch"
      },
      "attack": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Detector attack time Type: time.",
        "default": "10ms",
        "x-ferraus-kind": "time"
      },
      "release": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Detector release time Type: time.",
        "default": "100ms",
        "x-ferraus-kind": "time"
      },
      "lookahead": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "How far ahead the gain reacts (time); no added latency Type: time.",
        "default": "5ms",
        "x-ferraus-kind": "time"
      },
      "detector": {
        "type": "string",
        "enum": [
          "rms",
          "peak"
        ],
        "description": "Level detector Type: choice.",
        "default": "rms",
        "x-ferraus-kind": "choice"
      },
      "band": {
        "type": "string",
        "description": "Frequency band the detector listens to (low..high) Type: text.",
        "default": "20Hz..20kHz",
        "x-ferraus-kind": "str"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/dynamics.result.json",
    "title": "ferraus dynamics result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "dynamics"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
