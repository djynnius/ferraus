{
  "command": "pipeline prune",
  "summary": "Remove cached pipeline stage results not used recently",
  "category": "chains",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/pipeline_prune.args.json",
    "title": "ferraus pipeline prune arguments",
    "description": "Remove cached pipeline stage results not used recently",
    "type": "object",
    "properties": {
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "days": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "Remove entries not used for this many days (0 removes every entry) Range: 0..36500. Type: integer.",
        "default": "7",
        "x-ferraus-kind": "int"
      },
      "max_size": {
        "type": "string",
        "description": "Then remove the least recently used entries until the cache is at most this size, e.g. 2GB or 500MB Type: text.",
        "x-ferraus-kind": "str"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
