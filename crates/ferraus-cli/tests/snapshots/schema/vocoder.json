{
  "command": "vocoder",
  "summary": "Vocoder: make a carrier speak or sing with the input's voice",
  "category": "tone",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/vocoder.args.json",
    "title": "ferraus vocoder arguments",
    "description": "Vocoder: make a carrier speak or sing with the input's voice",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "carrier": {
        "type": "string",
        "description": "Audio file, or saw, square, pulse, noise or plugin:<name> (an installed instrument plugin playing --midi, --follow, or --note) Type: text.",
        "default": "saw",
        "x-ferraus-kind": "str"
      },
      "note": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Oscillator pitch when not following or playing MIDI Type: frequency.",
        "default": "C3",
        "x-ferraus-kind": "freq"
      },
      "follow": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Oscillator follows the modulator's detected pitch Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "midi": {
        "type": "string",
        "description": "MIDI file whose notes play the oscillator carrier (polyphonic) Type: path.",
        "x-ferraus-kind": "path"
      },
      "bands": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "Number of bands Range: 8..64. Type: integer.",
        "default": "24",
        "x-ferraus-kind": "int"
      },
      "range": {
        "type": "string",
        "description": "Frequency range of the bands (log spaced) Type: text.",
        "default": "80Hz..8kHz",
        "x-ferraus-kind": "str"
      },
      "attack": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Band envelope attack Type: time.",
        "default": "5ms",
        "x-ferraus-kind": "time"
      },
      "release": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Band envelope release Type: time.",
        "default": "30ms",
        "x-ferraus-kind": "time"
      },
      "formant_shift": {
        "type": "string",
        "examples": [
          "+200cents"
        ],
        "description": "Shift the vocal formants in semitones (+ brighter/smaller, - darker/bigger) Type: cents|semitones.",
        "default": "0",
        "x-ferraus-kind": "pitch"
      },
      "unvoiced": {
        "type": "string",
        "enum": [
          "noise",
          "off"
        ],
        "description": "Re-synthesize sibilants from noise Type: choice.",
        "default": "noise",
        "x-ferraus-kind": "choice"
      },
      "mode": {
        "type": "string",
        "enum": [
          "classic",
          "spectral"
        ],
        "description": "Filter-bank or STFT vocoder Type: choice.",
        "default": "classic",
        "x-ferraus-kind": "choice"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/vocoder.result.json",
    "title": "ferraus vocoder result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "vocoder"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
