{
  "command": "graphic-eq",
  "summary": "Linear-phase graphic equalizer (10, 20, or 30 bands)",
  "category": "tone",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/graphic_eq.args.json",
    "title": "ferraus graphic-eq arguments",
