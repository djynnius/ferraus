    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "bands": {
        "type": "string",
        "enum": [
          "10",
          "20",
          "30"
        ],
        "description": "Number of bands: 10 (octaves), 20 (half octaves), or 30 (third octaves) Type: choice.",
        "default": "10",
        "x-ferraus-kind": "choice"
      },
      "gains": {
        "type": "string",
        "description": "Gain per band in dB from the lowest band up, e.g. \"+2,0,-3\"; missing bands are 0 Type: list.",
        "default": "0",
        "x-ferraus-kind": "list"
      },
      "accuracy": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "FIR length (time); longer is more precise in the low bands Type: time.",
        "default": "1000ms",
        "x-ferraus-kind": "time"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
