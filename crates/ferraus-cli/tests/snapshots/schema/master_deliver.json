{
  "command": "master deliver",
  "summary": "Write the deliverable set",
  "category": "mastering",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/master_deliver.args.json",
    "title": "ferraus master deliver arguments",
    "description": "Write the deliverable set",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "formats": {
        "type": "string",
        "description": "Comma list of wav24, wav16, mp3, flac, aac Type: list.",
        "default": "wav24,wav16,mp3",
        "x-ferraus-kind": "list"
      },
      "tags": {
        "description": "Metadata key=value (title, artist, album, date, genre, track, ...); repeat or comma-separate Type: text. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Metadata key=value (title, artist, album, date, genre, track, ...); repeat or comma-separate Type: text.",
            "x-ferraus-kind": "str"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Metadata key=value (title, artist, album, date, genre, track, ...); repeat or comma-separate Type: text.",
              "x-ferraus-kind": "str"
            }
          }
        ]
      },
      "isrc": {
        "type": "string",
        "description": "ISRC code written to every deliverable (CC-XXX-YY-NNNNN) Type: text.",
        "x-ferraus-kind": "str"
      },
      "loudness_sheet": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Also write a loudness sheet (<output>.loudness.json and .csv) Type: flag.",
        "x-ferraus-kind": "flag"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/master_deliver.result.json",
    "title": "ferraus master deliver result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "master deliver"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
