{
  "command": "reverb",
  "summary": "Add reverb (plate, room, hall, chamber, or an impulse response)",
  "category": "space",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/reverb.args.json",
    "title": "ferraus reverb arguments",
    "description": "Add reverb (plate, room, hall, chamber, or an impulse response)",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "type": {
        "type": "string",
        "enum": [
          "plate",
          "room",
          "hall",
          "chamber"
        ],
        "description": "Algorithm Type: choice.",
        "default": "plate",
        "x-ferraus-kind": "choice"
      },
      "size": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Room size (scales the delay network) Type: percent.",
        "default": "50%",
        "x-ferraus-kind": "percent"
      },
      "decay": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Time for the tail to decay by 60 dB (RT60) Type: time.",
        "default": "1.8s",
        "x-ferraus-kind": "time"
      },
      "damping": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "How much faster high frequencies die away Type: percent.",
        "default": "50%",
        "x-ferraus-kind": "percent"
      },
      "predelay": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Gap before the reverb starts (0ms default with --ir) Type: time.",
        "default": "20ms",
        "x-ferraus-kind": "time"
      },
      "lowcut": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "High-pass on the reverb (keeps lows clean; 0Hz = off) Type: frequency.",
        "default": "120Hz",
        "x-ferraus-kind": "freq"
      },
      "highcut": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Low-pass on the reverb (0Hz = off) Type: frequency.",
        "default": "8kHz",
        "x-ferraus-kind": "freq"
      },
      "width": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Stereo width of the reverb (0% mono, 200% extra wide) Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet: 0% returns the input, 100% is reverb only Type: percent.",
        "default": "25%",
        "x-ferraus-kind": "percent"
      },
      "ir": {
        "type": "string",
        "description": "Impulse response file for convolution reverb Type: path.",
        "x-ferraus-kind": "path"
      },
      "trim_ir": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Cut the IR where it falls below this level relative to its peak Type: gain.",
        "default": "-60dB",
        "x-ferraus-kind": "gain"
      },
      "tail": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Extra length appended so the reverb can ring out (0s keeps the input length) Type: time.",
        "default": "0s",
        "x-ferraus-kind": "time"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/reverb.result.json",
    "title": "ferraus reverb result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "reverb"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
