{
  "command": "mix verify",
  "summary": "Pass or fail for a mix before mastering",
  "category": "mastering",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/mix_verify.args.json",
    "title": "ferraus mix verify arguments",
    "description": "Pass or fail for a mix before mastering",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "genre": {
        "type": "string",
        "enum": [
          "auto",
          "pop",
          "hiphop",
          "edm",
          "rock",
          "acoustic",
          "classical",
          "jazz",
          "podcast"
        ],
        "description": "Genre curve for the tonal checks; auto guesses from tempo, spectral tilt, low-end share, and crest factor (as master analyze does; mixes are more dynamic than masters, so name the genre when you know it) Type: choice.",
        "default": "auto",
        "x-ferraus-kind": "choice"
      },
      "reference": {
        "type": "string",
        "description": "Compare the tonal balance with this reference track instead of the genre curve Type: path.",
        "x-ferraus-kind": "path"
      },
      "headroom": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Highest acceptable true peak (dBTP, 4x oversampled): the room the master stage needs Type: gain.",
        "default": "-3dBTP",
        "x-ferraus-kind": "gain"
      },
      "min_lufs": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Quietest acceptable integrated loudness (LUFS) Type: gain.",
        "default": "-26LUFS",
        "x-ferraus-kind": "gain"
      },
      "max_lufs": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Loudest acceptable integrated loudness (LUFS); a louder mix has been limited already Type: gain.",
        "default": "-12LUFS",
        "x-ferraus-kind": "gain"
      },
      "min_plr": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Lowest acceptable peak-to-loudness ratio, true peak minus integrated loudness (dB); below it the mix is already limited (within 2 dB above it warns). An unlimited mix usually measures 12-18 dB; 5 dB of bus limiting brings it to about 10 Type: gain.",
        "default": "10dB",
        "x-ferraus-kind": "gain"
      },
      "tolerance": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Largest allowed tonal deviation from the curve or reference (dB, 1/3-octave bands averaged over an octave, overall level removed) Type: gain.",
        "default": "6dB",
        "x-ferraus-kind": "gain"
      },
      "mono_below": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "The mix should be mono below this frequency (L/R correlation at least 0.85); 0Hz turns the check off Type: frequency.",
        "default": "120Hz",
        "x-ferraus-kind": "freq"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/mix_verify.result.json",
    "title": "ferraus mix verify result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "mix verify"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
