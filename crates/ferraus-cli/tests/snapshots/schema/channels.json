              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Swap the left and right channels Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "mid_side": {
        "type": "string",
        "enum": [
          "encode",
          "decode"
        ],
        "description": "encode: L/R to mid/side; decode: mid/side back to L/R Type: choice.",
        "x-ferraus-kind": "choice"
      }
    },
    "required": [
