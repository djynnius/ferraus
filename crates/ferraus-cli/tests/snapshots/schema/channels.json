{
  "command": "channels",
  "summary": "Mix down, up-mix, extract, swap, or mid/side-convert channels",
  "category": "edit",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/channels.args.json",
