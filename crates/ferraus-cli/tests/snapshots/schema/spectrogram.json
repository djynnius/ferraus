{
  "command": "spectrogram",
  "summary": "Export a spectrogram as a PNG image or JSON matrix",
  "category": "inspect",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/spectrogram.args.json",
    "title": "ferraus spectrogram arguments",
    "description": "Export a spectrogram as a PNG image or JSON matrix",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "fft": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "FFT size in samples (frequency resolution) Type: integer.",
        "default": "2048",
        "x-ferraus-kind": "int"
      },
      "hop": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "Hop between frames in samples (time resolution) Type: integer.",
        "default": "512",
        "x-ferraus-kind": "int"
      },
      "mel": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "Number of mel bands; 0 for linear frequency bins Type: integer.",
        "default": "128",
        "x-ferraus-kind": "int"
      },
      "db_range": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Dynamic range shown, in dB below the loudest point Type: gain.",
        "default": "80dB",
        "x-ferraus-kind": "gain"
      },
      "fmin": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Lowest mel band edge (Hz) Type: frequency.",
        "default": "0Hz",
        "x-ferraus-kind": "freq"
      },
      "fmax": {
        "type": "string",
        "examples": [
          "1kHz"
        ],
        "description": "Highest mel band edge (Hz); defaults to half the sample rate Type: frequency.",
        "x-ferraus-kind": "freq"
      },
      "width": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "PNG width in pixels; 0 = one column per frame Type: integer.",
        "default": "0",
        "x-ferraus-kind": "int"
      },
      "height": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "PNG height in pixels; 0 = one row per band Type: integer.",
        "default": "0",
        "x-ferraus-kind": "int"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/spectrogram.result.json",
    "title": "ferraus spectrogram result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "spectrogram"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
