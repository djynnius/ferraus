{
  "command": "multiband",
  "summary": "Multiband compressor",
  "category": "dynamics",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/multiband.args.json",
    "title": "ferraus multiband arguments",
    "description": "Multiband compressor",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "crossovers": {
        "type": "string",
        "description": "Crossover frequencies, ascending; N crossovers make N+1 bands Type: list.",
        "default": "150Hz,3kHz",
        "x-ferraus-kind": "list"
      },
      "bands": {
        "oneOf": [
          {
            "type": "integer"
          },
          {
            "type": "string",
            "pattern": "^-?[0-9]+$"
          }
        ],
        "description": "Band count with default crossovers (2: 1kHz; 3: 150Hz,3kHz; 4: 120Hz,2kHz,10kHz; 5; 6) Range: 2..6. Type: integer.",
        "x-ferraus-kind": "int"
      },
      "threshold": {
        "type": "string",
        "description": "Per-band threshold(s) in dB Type: list.",
        "default": "-20dB",
        "x-ferraus-kind": "list"
      },
      "ratio": {
        "type": "string",
        "description": "Per-band ratio(s) Type: list.",
        "default": "2:1",
        "x-ferraus-kind": "list"
      },
      "attack": {
        "type": "string",
        "description": "Per-band attack time(s); auto = 20 ms (lowest) to 5 ms (highest) Type: list.",
        "default": "auto",
        "x-ferraus-kind": "list"
      },
      "release": {
        "type": "string",
        "description": "Per-band release time(s); auto = 200 ms (lowest) to 80 ms (highest) Type: list.",
        "default": "auto",
        "x-ferraus-kind": "list"
      },
      "makeup": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Output gain after the bands are summed Type: gain.",
        "default": "0dB",
        "x-ferraus-kind": "gain"
      },
      "limiter": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Add a true-peak output limiter Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "limiter_ceiling": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Ceiling of the output limiter Type: gain.",
        "default": "-1dBTP",
        "x-ferraus-kind": "gain"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/multiband.result.json",
    "title": "ferraus multiband result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "multiband"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
