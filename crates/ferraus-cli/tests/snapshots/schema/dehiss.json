{
  "command": "dehiss",
  "summary": "Reduce broadband hiss",
  "category": "restoration",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/dehiss.args.json",
    "title": "ferraus dehiss arguments",
    "description": "Reduce broadband hiss",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "floor": {
        "type": "string",
        "description": "Hiss level as dBFS RMS (-60dB) or 'auto' to measure it from the quietest frames Type: text.",
        "default": "auto",
        "x-ferraus-kind": "str"
      },
      "reduction": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "How far hiss-only bins are lowered, in dB Type: gain.",
        "default": "12dB",
        "x-ferraus-kind": "gain"
      },
      "range": {
        "type": "string",
        "description": "Frequency range the gate acts on (low..high, e.g. 2kHz..20kHz) Type: text.",
        "default": "2kHz..20kHz",
        "x-ferraus-kind": "str"
      },
      "transition": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Width in dB of the soft knee between full reduction and none Type: gain.",
        "default": "6dB",
        "x-ferraus-kind": "gain"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/dehiss.result.json",
    "title": "ferraus dehiss result",
    "type": "object",
    "required": [
