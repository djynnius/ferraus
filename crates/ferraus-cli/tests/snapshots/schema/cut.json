{
  "command": "cut",
  "summary": "Remove one or more time ranges and join the rest",
  "category": "edit",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/cut.args.json",
    "title": "ferraus cut arguments",
    "description": "Remove one or more time ranges and join the rest",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "range": {
        "description": "Range to remove as start..end (repeatable), e.g. 12s..15.5s Type: range. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "examples": [
              "0s..2s"
            ],
            "description": "Range to remove as start..end (repeatable), e.g. 12s..15.5s Type: range.",
            "x-ferraus-kind": "range"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "0s..2s"
              ],
              "description": "Range to remove as start..end (repeatable), e.g. 12s..15.5s Type: range.",
              "x-ferraus-kind": "range"
            }
          }
        ]
      },
      "crossfade": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Crossfade length (duration) at each join; 0ms for a hard splice Type: time.",
        "default": "10ms",
        "x-ferraus-kind": "time"
      },
      "crossfade_curve": {
        "type": "string",
        "enum": [
          "equal-power",
          "linear"
        ],
        "description": "Crossfade shape: equal-power keeps loudness steady, linear keeps amplitude steady Type: choice.",
        "default": "equal-power",
        "x-ferraus-kind": "choice"
      }
    },
    "required": [
      "inputs",
      "range"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/cut.result.json",
    "title": "ferraus cut result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "cut"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
