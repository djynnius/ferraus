{
  "command": "analyze pitch",
  "summary": "Pitch curve as JSON or CSV",
  "category": "inspect",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/analyze_pitch.args.json",
    "title": "ferraus analyze pitch arguments",
    "description": "Pitch curve as JSON or CSV",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "tracker": {
        "type": "string",
        "enum": [
          "pyin",
          "crepe",
          "rmvpe",
          "swiftf0"
        ],
        "description": "Pitch tracker Type: choice.",
        "default": "pyin",
        "x-ferraus-kind": "choice"
      },
      "hop": {
        "type": "string",
