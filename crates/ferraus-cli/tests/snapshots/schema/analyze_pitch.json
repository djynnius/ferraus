          "1.5s"
        ],
        "description": "Time between frames Type: time.",
        "default": "10ms",
        "x-ferraus-kind": "time"
      },
      "range": {
        "type": "string",
        "description": "Pitch range searched, low..high (Hz, kHz or note names) Type: text.",
