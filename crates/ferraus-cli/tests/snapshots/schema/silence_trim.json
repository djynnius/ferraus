{
  "command": "silence trim",
  "summary": "Remove leading and trailing silence, optionally long pauses too",
  "category": "edit",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/silence_trim.args.json",
    "title": "ferraus silence trim arguments",
    "description": "Remove leading and trailing silence, optionally long pauses too",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "edges": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Trim leading and trailing silence (the default behaviour) Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "all": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Also shorten long silences inside the audio Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "threshold": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Level (dBFS) below which audio counts as silence Type: gain.",
        "default": "-60dB",
        "x-ferraus-kind": "gain"
      },
      "keep": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Silence (duration) kept before the first and after the last sound Type: time.",
        "default": "10ms",
        "x-ferraus-kind": "time"
      },
      "min": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "With --all: inner silences longer than this (duration) are shortened Type: time.",
        "default": "1s",
        "x-ferraus-kind": "time"
      },
      "max_gap": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "With --all: length (duration) inner silences are shortened to Type: time.",
        "default": "500ms",
        "x-ferraus-kind": "time"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/silence_trim.result.json",
    "title": "ferraus silence trim result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "silence trim"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
