{
  "command": "hum",
  "summary": "Turn a hummed idea into an instrument part",
  "category": "midi",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/hum.args.json",
    "title": "ferraus hum arguments",
    "description": "Turn a hummed idea into an instrument part",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "to": {
        "type": "string",
        "description": "Instrument to render with: piano, strings, \"Acoustic Bass\", gm:48, sf2:<path>, an installed sound name (as render --instrument) Type: text.",
        "default": "piano",
        "x-ferraus-kind": "str"
      },
      "grid": {
        "type": "string",
        "examples": [
          "1/16"
        ],
        "description": "Quantize grid (1/16, 1/8, 1/8T), auto to detect, or off Type: grid.",
        "default": "1/16",
        "x-ferraus-kind": "grid"
      },
      "strength": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "How far notes move toward the grid (80% keeps some feel) Range: 0..100%. Type: percent.",
        "default": "80%",
        "x-ferraus-kind": "percent"
      },
      "bpm": {
        "type": "string",
        "description": "Tempo in BPM, or auto to detect it from the humming (also set by the global --bpm) Type: text.",
        "default": "auto",
        "x-ferraus-kind": "str"
      },
      "key_snap": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Snap out-of-key notes to the detected key when its confidence is above 0.6 Type: on|off.",
        "default": "on",
        "x-ferraus-kind": "switch"
      },
      "octave": {
        "type": "string",
        "description": "auto moves the part into the instrument's comfortable range; or a fixed shift in octaves (-1, +1) Type: text.",
        "default": "auto",
        "x-ferraus-kind": "str"
      },
      "min_note": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Shortest note kept (60ms) Type: time.",
        "default": "60ms",
        "x-ferraus-kind": "time"
      },
      "onset_sensitivity": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "How readily repeated or sliding notes are split (see transcribe) Range: 0..100%. Type: percent.",
        "default": "50%",
        "x-ferraus-kind": "percent"
      },
      "tail": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Time rendered after the last note so it rings out (2s) Type: time.",
        "default": "2s",
        "x-ferraus-kind": "time"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/hum.result.json",
    "title": "ferraus hum result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "hum"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
