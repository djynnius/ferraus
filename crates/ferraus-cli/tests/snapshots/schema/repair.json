{
  "command": "repair",
  "summary": "Spectral repair of a time-frequency region from its neighbours",
  "category": "restoration",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/repair.args.json",
    "title": "ferraus repair arguments",
    "description": "Spectral repair of a time-frequency region from its neighbours",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "range": {
        "description": "Time range to repair (start..end, e.g. 1:02.50..1:02.70); repeatable Type: range. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "examples": [
              "0s..2s"
            ],
            "description": "Time range to repair (start..end, e.g. 1:02.50..1:02.70); repeatable Type: range.",
            "x-ferraus-kind": "range"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "examples": [
                "0s..2s"
              ],
              "description": "Time range to repair (start..end, e.g. 1:02.50..1:02.70); repeatable Type: range.",
              "x-ferraus-kind": "range"
            }
          }
        ]
      },
      "freq": {
        "type": "string",
        "description": "Frequency band to repair (low..high, e.g. 2kHz..6kHz) or 'all' Type: text.",
        "default": "all",
        "x-ferraus-kind": "str"
      },
      "method": {
        "type": "string",
        "enum": [
          "interpolate",
          "attenuate"
        ],
        "description": "Re-synthesise from neighbours, or only attenuate to their level Type: choice.",
        "default": "interpolate",
        "x-ferraus-kind": "choice"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs",
      "range"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/repair.result.json",
    "title": "ferraus repair result",
    "type": "object",
    "required": [
