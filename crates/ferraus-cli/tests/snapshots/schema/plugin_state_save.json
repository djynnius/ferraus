{
  "command": "plugin state save",
  "summary": "Save a plugin's native state as base64 JSON",
  "category": "plugins",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/plugin_state_save.args.json",
    "title": "ferraus plugin state save arguments",
    "description": "Save a plugin's native state as base64 JSON",
    "type": "object",
    "properties": {
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "name": {
        "type": "string",
        "description": "Plugin name, id, or path to a .clap/.vst3 bundle (path#plugin.id picks one plugin in a bundle) Type: text.",
        "x-ferraus-kind": "str"
      },
      "param": {
        "description": "Set a parameter: name=value, by display name or stable id; value in display units (cutoff=2.5kHz, mix=30%, gain=-6dB) or normalized (norm:0.3) Type: text. Repeatable.",
        "oneOf": [
          {
            "type": "string",
            "description": "Set a parameter: name=value, by display name or stable id; value in display units (cutoff=2.5kHz, mix=30%, gain=-6dB) or normalized (norm:0.3) Type: text.",
            "x-ferraus-kind": "str"
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Set a parameter: name=value, by display name or stable id; value in display units (cutoff=2.5kHz, mix=30%, gain=-6dB) or normalized (norm:0.3) Type: text.",
              "x-ferraus-kind": "str"
            }
          }
        ]
      },
      "preset": {
        "type": "string",
        "description": "Load one of the plugin's presets by name (see 'plugin presets list') before applying --param values Type: text.",
        "x-ferraus-kind": "str"
      },
      "state": {
        "type": "string",
        "description": "Restore native plugin state from a file written by 'plugin state save' (or a sidecar) before the preset and --param values Type: path.",
        "x-ferraus-kind": "path"
      },
      "watchdog": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Stop the plugin host after this long without progress (default 60s, or FERRAUS_PLUGIN_WATCHDOG_S) Type: time.",
        "x-ferraus-kind": "time"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/plugin_state_save.result.json",
    "title": "ferraus plugin state save result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
