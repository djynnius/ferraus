{
  "command": "deresonate",
  "summary": "Dynamic resonance suppressor: tame rings or harsh peaks as they happen",
  "category": "dynamics",
  "best_effort": false,
  "fx_stage": true,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/deresonate.args.json",
    "title": "ferraus deresonate arguments",
    "description": "Dynamic resonance suppressor: tame rings or harsh peaks as they happen",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin"
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "band": {
        "type": "string",
        "examples": [
          "80Hz..8kHz"
        ],
        "description": "Frequency range worked on (low..high); the reduction fades out over a quarter octave beyond each edge Type: frequency range.",
        "default": "100Hz..16kHz",
        "x-ferraus-kind": "freq_range"
      },
      "depth": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Largest reduction at any frequency Type: gain.",
        "default": "6dB",
        "x-ferraus-kind": "gain"
      },
      "threshold": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "How far a peak must stand above its neighbourhood before it is turned down (higher: only the most prominent peaks) Type: gain.",
        "default": "3dB",
        "x-ferraus-kind": "gain"
      },
      "sharpness": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Width of the neighbourhood a peak is compared with: 0% about an octave (broad build-ups count too), 100% about 1/12 octave but never under ±250 Hz (only narrow rings count) Type: percent.",
        "default": "50%",
        "x-ferraus-kind": "percent"
      },
      "attack": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "How fast each frequency's level estimate rises, i.e. how fast a reduction engages Type: time.",
        "default": "5ms",
        "x-ferraus-kind": "time"
      },
      "release": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "How fast each frequency's level estimate falls, i.e. how fast a reduction lets go Type: time.",
        "default": "80ms",
        "x-ferraus-kind": "time"
      },
      "link": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "One gain curve for all channels, from their summed power, so the stereo image stays put (off: each channel on its own) Type: on|off.",
        "default": "on",
        "x-ferraus-kind": "switch"
      },
      "listen": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "on",
              "off",
              "true",
              "false"
            ]
          }
        ],
        "description": "Output only what is removed (input minus output), for checking Type: flag.",
        "x-ferraus-kind": "flag"
      },
      "mix": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Dry/wet balance: 0% returns the input unchanged, 100% is fully processed Type: percent.",
        "default": "100%",
        "x-ferraus-kind": "percent"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/deresonate.result.json",
    "title": "ferraus deresonate result",
    "type": "object",
    "required": [
      "ok",
      "command",
      "ferraus_version",
      "schema_version",
      "inputs",
      "outputs",
      "params",
      "warnings",
      "timing_ms"
    ],
    "properties": {
      "ok": {
        "type": "boolean"
      },
      "command": {
        "const": "deresonate"
      },
      "ferraus_version": {
        "type": "string"
      },
      "schema_version": {
        "const": 1
      },
      "inputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            },
            "sample_rate": {
              "type": "integer"
            },
            "channels": {
              "type": "integer"
            }
          }
        }
      },
      "outputs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "duration_s": {
              "type": "number"
            }
          }
        }
      },
      "params": {
        "type": "object",
        "description": "Every parameter after defaults, presets, and run-time detection"
      },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      },
      "metrics": {
        "type": "object"
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "result": {
        "description": "Command-specific result data"
      },
      "error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "exit_code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          }
        }
      },
      "timing_ms": {
        "type": "integer"
      },
      "dry_run": {
        "type": "boolean"
      }
    }
  }
}
