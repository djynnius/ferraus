{
  "command": "analyze masking",
  "summary": "Where stem b masks stem a (same bands, same time), with an EQ cut for b",
  "category": "inspect",
  "best_effort": false,
  "fx_stage": false,
  "arguments": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/analyze_masking.args.json",
    "title": "ferraus analyze masking arguments",
    "description": "Where stem b masks stem a (same bands, same time), with an EQ cut for b",
    "type": "object",
    "properties": {
      "inputs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 2,
        "description": "Input file paths (audio or video files); globs allowed; '-' reads stdin",
        "maxItems": 2
      },
      "output": {
        "type": "string",
        "description": "Output path or template ({name}, {stem}, {index}, {ext}); '-' for stdout"
      },
      "threshold": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ],
        "examples": [
          "50%"
        ],
        "description": "Band score at or above which a region is reported (0..100%) Type: percent.",
        "default": "50%",
        "x-ferraus-kind": "percent"
      },
      "window": {
        "type": "string",
        "examples": [
          "1.5s"
        ],
        "description": "Frame length for deciding when each stem is playing Type: time.",
        "default": "100ms",
        "x-ferraus-kind": "time"
      },
      "floor": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "A frame counts as playing when its RMS is within this many dB of the stem's loudest frame Type: gain.",
        "default": "-30dB",
        "x-ferraus-kind": "gain"
      },
      "max_cut": {
        "type": "string",
        "examples": [
          "-6dB"
        ],
        "description": "Deepest suggested cut for b Type: gain.",
        "default": "-4dB",
        "x-ferraus-kind": "gain"
      },
      "levels": {
        "type": "string",
        "enum": [
          "as-is",
          "ignore"
        ],
        "description": "as-is: a band only counts while b is within 10 dB of a there (balanced or processed stems; cuts and fader moves lower the score); ignore: compare spectral shapes only (raw, unbalanced stems) Type: choice.",
        "default": "as-is",
        "x-ferraus-kind": "choice"
      }
    },
    "required": [
      "inputs"
    ],
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://djynnius.github.io/ferraus/schema/v1/analyze_masking.result.json",
