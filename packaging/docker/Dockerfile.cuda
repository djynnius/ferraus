# CUDA image: ONNX Runtime's CUDA execution provider is fetched at build time.
FROM rust:1.97-trixie AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p ferraus --bins --features cuda

FROM nvidia/cuda:13.0.1-cudnn-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates libmp3lame0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/ferraus /usr/local/bin/ferraus
COPY --from=build /src/target/release/ferraus-plughost /usr/local/lib/ferraus/ferraus-plughost
ENV FERRAUS_HOME=/data
RUN ferraus accelerate install -y || true
VOLUME ["/data", "/work"]
WORKDIR /work
ENTRYPOINT ["ferraus"]
CMD ["--help"]
