{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.djynnius/ferraus",
  "title": "ferraus",
  "description": "Command-line audio workstation: stems, restoration, tuning, sheet music, mastering. JSON everywhere.",
  "version": "0.1.3",
  "websiteUrl": "https://djynnius.github.io/ferraus",
  "repository": {
    "url": "https://github.com/djynnius/ferraus",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "oci",
      "identifier": "ghcr.io/djynnius/ferraus:v0.1.3",
      "runtimeHint": "docker",
      "transport": { "type": "stdio" },
      "runtimeArguments": [
        { "type": "positional", "value": "-i" },
        { "type": "positional", "value": "--rm" },
        {
          "type": "named",
          "name": "-v",
          "value": "{music_dir}:/work",
          "variables": {
            "music_dir": {
              "description": "Folder with your audio; ferraus reads and writes only here",
              "format": "filepath",
              "isRequired": true
            }
          }
        },
        { "type": "named", "name": "-v", "value": "ferraus-data:/data" }
      ],
      "packageArguments": [
        { "type": "positional", "value": "mcp" },
        { "type": "positional", "value": "serve" },
        { "type": "named", "name": "--allow", "value": "/work" }
      ]
    }
  ]
}
